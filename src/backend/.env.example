# SimplifyMove Backend Environment Configuration Template
# Copy this file to .env in the backend folder and update values for your environment

# Environment Mode
NODE_ENV=development

# Server Configuration
PORT=5000
API_VERSION=v1

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-database-password-here
DB_NAME=simplifymove
DB_DIALECT=mysql

# JWT Configuration
# Use a strong, random secret key in production
JWT_SECRET=your-super-secret-key-change-this-in-production

# CORS Configuration
# Comma-separated list of allowed origins for the frontend
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Frontend Configuration
FRONTEND_URL=http://localhost:5173

# Email Configuration (if using email features)
# SMTP Settings
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-email-password
SMTP_FROM_EMAIL=noreply@simplifymove.com

# Payment Gateway Configuration
# Stripe (optional)
# STRIPE_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
# STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# Razorpay (optional)
# RAZORPAY_KEY_ID=key_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=key_xxxxxxxxxxxx

# Cloud Storage Configuration (optional)
# Cloudinary
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# Logging Configuration
LOG_LEVEL=debug
LOG_DIR=./logs

# Session Configuration
# Use a strong, random secret in production
SESSION_SECRET=your-session-secret-here

# API Keys (optional external services)
# Google APIs
# GOOGLE_API_KEY=your-google-api-key

# Twilio (for SMS notifications)
# TWILIO_ACCOUNT_SID=your-twilio-sid
# TWILIO_AUTH_TOKEN=your-twilio-token
